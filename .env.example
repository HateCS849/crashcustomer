# rule: deterministic browser baseline. ollama: real LLM decides each action.
CRASHCUSTOMER_BACKEND=rule
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional existing browser; no personal profile is used.
# CRASHCUSTOMER_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CRASHCUSTOMER_HEADLESS=true
# The runner connects only to this local application, never arbitrary user URLs.
CRASHCUSTOMER_BASE_URL=http://127.0.0.1:8710
# Registered apps: loopback, *.localhost and *.test run by default. Add staging hosts explicitly (comma separated).
# Never list a production host: campaigns inject failures and submit forms.
# CRASHCUSTOMER_ALLOWED_HOSTS=staging.example.com
# Optional RAG embeddings (BM25 is used when unset), e.g. after `ollama pull nomic-embed-text`
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional LangSmith tracing. Sends prompts, observations and outputs to LangSmith when enabled.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=crashcustomer
